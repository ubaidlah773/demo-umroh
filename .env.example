# Database connection string (PostgreSQL for Supabase/Neon/Vercel Postgres, or SQLite file:./dev.db)
DATABASE_URL="file:./dev.db"

# Secret key for admin session authentication
AUTH_SECRET="your-secure-random-32-char-secret-key"

# Storage credentials (for Supabase Storage / Cloudinary / S3)
STORAGE_URL="https://your-project.supabase.co/storage/v1"
STORAGE_KEY="your-storage-key"
STORAGE_SECRET="your-storage-secret"
